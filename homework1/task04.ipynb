   "source": [
    "### 4. Используя цикл, создайте список, содержащий квадраты всех целых чисел от 1 до 10, и выведите его на экран. \n",
    "\n",
    "P.S. Сложность: временная O(n), по памяти - O(n)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3a3b42e9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 4, 9, 16, 25, 36, 49, 64, 81, 100]\n"
     ]
    }
   ],
   "source": [
    "squares = [number * number for number in range(1, 11)]\n",
    "\n",
    "print(squares)"
   ]
  }
